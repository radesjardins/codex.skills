{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "coolify": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@radoriginllc/coolify-mcp"
      ],
      "env": {
        "COOLIFY_URL": "${COOLIFY_URL}",
        "COOLIFY_API_TOKEN": "${COOLIFY_API_TOKEN}"
      }
    }
  }
}
